{
  "name": "mueslidian",
  "version": "0.1.0",
  "description": "Obsidian plugin that syncs meetings from Granola.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src bin tests",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.7.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "obsidian": "^1.4.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
